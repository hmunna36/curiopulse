# build intermediates (frames, stems, models) and fonts fetched by build.sh
videos/*/.work/
videos/*/src/fonts/
__pycache__/
.venv/
.DS_Store
# long-form videos: build intermediates, fetched fonts, and the rendered MP4 (it lives on YouTube)
long/*/.work/
long/*/src/fonts/
long/*/*.mp4
# a fresh work folder for a rebuild proof (WORK=../.work-build bash src/build.sh): never committed
videos/*/.work-*/
