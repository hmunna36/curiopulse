{
  "voice": "af_heart",
  "note": "Directed read. Per phrase: speed (pace), tone (low/mid/high pitch placement), end (rise = curiosity, fall = conclusion), emph (words to lean on), pause after (s), breath before (soft | inhale | gasp). Takes are auditioned over the voice's own style rows and the best-scoring one is kept.",
  "segments": [
    {"t": "Getting struck by lightning sounds instantly fatal, right?", "speed": 1.2, "tone": "mid", "end": "rise", "emph": ["instantly", "fatal"], "pause": 0.28},
    {"t": "Well... not always.", "speed": 1.1, "tone": "low", "end": "fall", "emph": ["not"], "pause": 0.3},
    {"t": "As the storm rolls in, charge zigzags down...", "speed": 1.25, "tone": "low", "end": "any", "emph": ["storm", "zigzags"], "pause": 0.12, "breath": "soft"},
    {"t": "His body?", "speed": 1.15, "tone": "mid", "end": "rise", "emph": ["body"], "pause": 0.1},
    {"t": "It throws a spark up to meet it...", "speed": 1.2, "tone": "mid", "end": "any", "emph": ["spark"], "pause": 0.16},
    {"t": "and— they connect!", "speed": 1.3, "tone": "high", "end": "any", "emph": ["connect"], "pause": 0.5, "gain": 1.5},
    {"t": "Thirty thousand amps.", "speed": 1.25, "tone": "high", "end": "fall", "emph": ["thirty", "thousand"], "pause": 0.08, "gain": 1.0},
    {"t": "Hotter than the Sun's surface.", "speed": 1.25, "tone": "mid", "end": "fall", "emph": ["sun's"], "pause": 0.22},
    {"t": "But here's the thing...", "speed": 1.15, "tone": "low", "end": "any", "emph": [], "pause": 0.16, "breath": "soft", "gain": -1.0},
    {"t": "most of it never even gets inside.", "speed": 1.25, "tone": "low", "end": "fall", "emph": ["never", "inside"], "pause": 0.1, "gain": -0.5},
    {"t": "It flashes over his wet skin, turning rain to steam so fast it can blow his shoes off,", "speed": 1.32, "tone": "low", "end": "any", "emph": ["steam", "shoes"], "pause": 0.08},
    {"t": "leaving fern-shaped marks behind.", "speed": 1.2, "tone": "mid", "end": "fall", "emph": ["fern-shaped"], "pause": 0.24},
    {"t": "The current that does get in?", "speed": 1.25, "tone": "low", "end": "rise", "emph": ["does"], "pause": 0.1},
    {"t": "It races along his nerves.", "speed": 1.3, "tone": "mid", "end": "fall", "emph": ["races", "nerves"], "pause": 0.08},
    {"t": "They run on tiny electrical signals...", "speed": 1.25, "tone": "mid", "end": "any", "emph": ["tiny"], "pause": 0.14},
    {"t": "and this surge drowns them out.", "speed": 1.3, "tone": "high", "end": "fall", "emph": ["surge", "drowns"], "pause": 0.22, "gain": 1.0},
    {"t": "His legs can go limp for hours.", "speed": 1.25, "tone": "low", "end": "fall", "emph": ["limp", "hours"], "pause": 0.1},
    {"t": "His brain's breathing center?", "speed": 1.2, "tone": "mid", "end": "rise", "emph": ["breathing"], "pause": 0.08},
    {"t": "It can shut down.", "speed": 1.15, "tone": "low", "end": "fall", "emph": ["shut"], "pause": 0.3},
    {"t": "Now... his heart runs on electricity too.", "speed": 1.12, "tone": "low", "end": "fall", "emph": ["heart", "electricity"], "pause": 0.12, "breath": "soft", "gain": -0.5},
    {"t": "Lightning hits it like a giant defibrillator...", "speed": 1.18, "tone": "mid", "end": "any", "emph": ["giant", "defibrillator"], "pause": 0.12},
    {"t": "and for a moment...", "speed": 1.08, "tone": "low", "end": "any", "emph": ["moment"], "pause": 0.35, "gain": -0.5},
    {"t": "it stops.", "speed": 1.0, "tone": "low", "end": "fall", "emph": ["stops"], "pause": 0.8},
    {"t": "But here's the twist.", "speed": 1.2, "tone": "high", "end": "any", "emph": ["twist"], "pause": 0.16, "gain": 1.0},
    {"t": "The heart often restarts on its own.", "speed": 1.25, "tone": "high", "end": "fall", "emph": ["restarts", "own"], "pause": 0.3},
    {"t": "Breathing, though?", "speed": 1.1, "tone": "mid", "end": "rise", "emph": ["breathing"], "pause": 0.5, "breath": "inhale", "gasp_after": true},
    {"t": "It might not.", "speed": 1.08, "tone": "low", "end": "fall", "emph": ["might", "not"], "pause": 0.25},
    {"t": "So fast CPR saves lives.", "speed": 1.25, "tone": "mid", "end": "fall", "emph": ["cpr", "lives"], "pause": 0.14},
    {"t": "And victims carry no charge. They're safe to touch.", "speed": 1.28, "tone": "mid", "end": "fall", "emph": ["no", "safe"], "pause": 0.25},
    {"t": "That's why about nine in ten survive.", "speed": 1.2, "tone": "high", "end": "fall", "emph": ["nine", "ten", "survive"], "pause": 0.3},
    {"t": "And one park ranger?", "speed": 1.15, "tone": "mid", "end": "rise", "emph": ["ranger"], "pause": 0.12, "breath": "soft"},
    {"t": "Struck seven times...", "speed": 1.15, "tone": "mid", "end": "any", "emph": ["seven"], "pause": 0.3},
    {"t": "and he survived every single one.", "speed": 1.1, "tone": "mid", "end": "fall", "emph": ["every", "single", "one"], "pause": 0.0, "gain": 1.0}
  ]
}
