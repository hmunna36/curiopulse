{
  "voice": "af_heart",
  "target": 90.0,
  "note": "Directed read. Per phrase: speed (pace), tone (low/mid/high pitch placement), end (rise = curiosity, fall = conclusion), emph (words to lean on), pause after (s), breath before (soft | inhale), gasp_after, gain (dB); alts = punctuation variants auditioned alongside the line. Takes are auditioned over the voice's own style rows x pace offsets and the best-scoring one is kept.",
  "segments": [
    {"t": "Getting struck by lightning sounds instantly fatal, right?", "speed": 1.044, "tone": "mid", "end": "rise", "emph": ["instantly", "fatal"], "pause": 0.25},
    {"t": "Well... not always.", "speed": 0.957, "tone": "low", "end": "fall", "emph": ["not"], "pause": 0.3, "rows": "more"},
    {"t": "As the storm rolls in, charge zigzags down...", "speed": 1.087, "tone": "low", "end": "any", "emph": ["storm", "zigzags"], "pause": 0.12, "breath": "soft"},
    {"t": "His body?", "speed": 1.0, "tone": "mid", "end": "rise", "emph": ["body"], "pause": 0.1, "alts": ["His... body?", "His body...?", "And his body?"], "rows": "more"},
    {"t": "It throws a spark up to meet it...", "speed": 1.044, "tone": "mid", "end": "any", "emph": ["spark"], "pause": 0.12},
    {"t": "and— they connect!", "speed": 1.131, "tone": "high", "end": "any", "emph": ["connect"], "pause": 0.45, "gain": 1.5},
    {"t": "Thirty thousand amps.", "speed": 1.087, "tone": "high", "end": "fall", "emph": ["thirty", "thousand"], "pause": 0.08, "gain": 1.0, "rows": "more"},
    {"t": "Hotter than the Sun's surface.", "speed": 1.087, "tone": "mid", "end": "fall", "emph": ["sun's"], "pause": 0.2},
    {"t": "But here's the thing...", "speed": 1.0, "tone": "low", "end": "any", "emph": [], "pause": 0.14, "breath": "soft", "gain": -1.0},
    {"t": "most of it never even gets inside.", "speed": 1.087, "tone": "low", "end": "fall", "emph": ["never", "inside"], "pause": 0.1, "gain": -0.5},
    {"t": "It flashes over his wet skin, turning rain to steam so fast it can blow his shoes off,", "speed": 1.148, "tone": "low", "end": "any", "emph": ["steam", "shoes"], "pause": 0.08},
    {"t": "leaving fern-shaped marks behind.", "speed": 1.044, "tone": "mid", "end": "fall", "emph": ["fern-shaped"], "pause": 0.22, "rows": "more"},
    {"t": "The current that does get in?", "speed": 1.087, "tone": "low", "end": "rise", "emph": ["does"], "pause": 0.1, "alts": ["The current that does get in...?"]},
    {"t": "It races along his nerves.", "speed": 1.131, "tone": "mid", "end": "fall", "emph": ["races", "nerves"], "pause": 0.08},
    {"t": "They run on tiny electrical signals...", "speed": 1.087, "tone": "mid", "end": "any", "emph": ["tiny"], "pause": 0.1},
    {"t": "and this surge drowns them out.", "speed": 1.131, "tone": "high", "end": "fall", "emph": ["surge", "drowns"], "pause": 0.2, "gain": 1.0},
    {"t": "His legs can go limp for hours.", "speed": 1.087, "tone": "low", "end": "fall", "emph": ["limp", "hours"], "pause": 0.1},
    {"t": "His brain's breathing center?", "speed": 1.044, "tone": "mid", "end": "rise", "emph": ["breathing"], "pause": 0.08, "alts": ["His brain's... breathing center?"]},
    {"t": "It can shut down.", "speed": 1.0, "tone": "low", "end": "fall", "emph": ["shut"], "pause": 0.25, "rows": "more"},
    {"t": "Now... his heart runs on electricity too.", "speed": 0.974, "tone": "low", "end": "fall", "emph": ["heart", "electricity"], "pause": 0.12, "breath": "soft", "gain": -0.5},
    {"t": "Lightning hits it like a giant defibrillator...", "speed": 1.027, "tone": "mid", "end": "any", "emph": ["giant", "defibrillator"], "pause": 0.1},
    {"t": "and for a moment...", "speed": 0.94, "tone": "low", "end": "any", "emph": ["moment"], "pause": 0.3, "gain": -0.5},
    {"t": "it stops.", "speed": 0.87, "tone": "low", "end": "fall", "emph": ["stops"], "pause": 0.7},
    {"t": "But here's the twist.", "speed": 1.044, "tone": "high", "end": "any", "emph": ["twist"], "pause": 0.12, "gain": 1.0},
    {"t": "The heart often restarts on its own.", "speed": 1.087, "tone": "high", "end": "fall", "emph": ["restarts", "own"], "pause": 0.28},
    {"t": "Breathing, though?", "speed": 0.957, "tone": "mid", "end": "rise", "emph": ["breathing"], "pause": 0.5, "gasp_after": true, "alts": ["Breathing though?", "Breathing, though...?"], "rows": "more"},
    {"t": "It might not.", "speed": 0.94, "tone": "low", "end": "fall", "emph": ["might", "not"], "pause": 0.25},
    {"t": "So fast CPR saves lives.", "speed": 1.087, "tone": "mid", "end": "fall", "emph": ["cpr", "lives"], "pause": 0.12},
    {"t": "And victims carry no charge. They're safe to touch.", "speed": 1.114, "tone": "mid", "end": "fall", "emph": ["no", "safe"], "pause": 0.22},
    {"t": "That's why about nine in ten survive.", "speed": 1.044, "tone": "high", "end": "fall", "emph": ["nine", "ten", "survive"], "pause": 0.28},
    {"t": "And one park ranger?", "speed": 1.0, "tone": "mid", "end": "rise", "emph": ["ranger"], "pause": 0.12, "breath": "soft", "alts": ["And one... park ranger?"], "rows": "more"},
    {"t": "Struck seven times...", "speed": 1.0, "tone": "mid", "end": "any", "emph": ["seven"], "pause": 0.25},
    {"t": "and he survived every single one.", "speed": 0.957, "tone": "mid", "end": "fall", "emph": ["every", "single", "one"], "pause": 0.0, "gain": 1.0}
  ]
}
